# Voorbeeld van .env — kopieer dit naar een bestand '.env' en vul echte waarden in.
# Dit .example-bestand mag WEL op GitHub (bevat geen echte geheimen).
PORT=3003

# CMS-login (kies een eigen sterk wachtwoord + een lange willekeurige token)
ADMIN_PASSWORD=verander-mij
TOKEN=verander-mij-in-een-lange-willekeurige-string

# Database
DB_HOST=localhost
DB_PORT=3307
DB_USER=root
DB_PASSWORD=root
DB_NAME=portfolio_cms
